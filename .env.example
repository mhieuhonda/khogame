# ============================================================
# .env.example — copy thành .env và điền giá trị thật
# ============================================================
#   cp .env.example .env
#   $EDITOR .env
#
# Mọi giá trị dưới đây là PLACEHOLDER — KHÔNG commit .env (đã có trong
# .gitignore + .dockerignore). Secrets prod khai báo trong tab
# Environment Variables của Service trên Coolify, compose nội suy ${VAR}.

# ─── Server ──────────────────────────────────────────────────
# Host bind. Prod: 0.0.0.0 (lắng nghe mọi interface qua Traefik).
# Local: 0.0.0.0 (cần cho docker port forward).
HOST=0.0.0.0

# Port bind. Phải khớp `EXPOSE` trong Dockerfile + Traefik label
# `loadbalancer.server.port`. Đổi port cần đổi cả 3 nơi.
PORT=3000

# Base URL public — dùng cho og:image, canonical link, sitemap, RSS,
# OAuth redirect validation. KHÔNG có trailing slash (app tự trim nhưng
# đặt chuẩn tránh warning log). Prod: https://louis.vangioitutien.com
BASE_URL=https://louis.vangioitutien.com

# ─── Database PostgreSQL 17 ──────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DB
# Prod: compose.prod.yml override bằng
#   DATABASE_URL=postgres://khogame:${DB_PASSWORD}@khogame-db:5432/khogame
# Local (docker-compose.yml): khogame:khogame_local_dev@postgres:5432/khogame
DATABASE_URL=postgres://khogame:password@localhost:5432/khogame

# ─── Session (HMAC sign cookie trong tương lai) ─────────────
# Generate: openssl rand -hex 32   (64 hex chars = 32 bytes entropy)
# Bắt buộc ≥ 32 bytes (config.rs check độ dài ở startup).
# Prod: set key thật 64-byte hex. Dev: default placeholder pass check.
SESSION_KEY=replace-with-your-64-byte-hex-random-string-min-32-bytes-entropy

# ─── Google OAuth 2.0 ────────────────────────────────────────
# Lấy tại: https://console.cloud.google.com/apis/credentials
# Tạo OAuth client ID type "Web application", Authorized redirect URIs
# thêm: https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-secret
# Phải nằm dưới BASE_URL (config.rs validate ở startup — chống OAuth
# code bị redirect sang domain khác do env sai).
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# ─── Admin ───────────────────────────────────────────────────
# Email này tự động được cấp quyền Admin khi đăng nhập Google lần đầu.
# Khuyến nghị: dùng email Google Account cá nhân của operator chính.
# Nếu đổi email admin: đổi env + restart app. User cũ tự giữ role admin
# (đã lưu trong DB), chỉ user mới theo email mới mới được auto-admin.
ADMIN_EMAIL=khongdich.admin@gmail.com

# ─── AI Agent (tùy chọn — để trống nếu không dùng) ───────────
# Secret chia sẻ out-of-band cho AI Agent được phép. BẮT BUỘC ở prod
# nếu muốn bật tính năng AI; để trống = endpoint /auth/ai/* trả 503.
# Generate: openssl rand -hex 32
# AI_AGENT_SECRET=

# Số ngày sống của phiên AI Agent (mặc định 90, max 365 — chống overflow
# INTERVAL Postgres + tránh phiên quá lâu không rotate).
# AI_AGENT_SESSION_TTL_DAYS=90

# ─── Database pool tuning (tuỳ chọn) ────────────────────────
# PostgreSQL 17 default max_connections=100. Nếu 1 stack dùng chung
# cluster PG với nhiều service → giảm DB_MAX_CONNECTIONS cho mỗi service
# tránh cạn slot. Coolify single-service stack: 15 là safe default.
# DB_MAX_CONNECTIONS=15
# DB_MIN_CONNECTIONS=1
# DB_ACQUIRE_TIMEOUT_SECS=10

# ─── Vận hành (tuỳ chọn) ────────────────────────────────────
# Chu kỳ janitor dọn session hết hạn + notification đã đọc > 90 ngày +
# daily_stats cũ > 90 ngày. Tối thiểu 60s, mặc định 21600 (6h).
# Janitor chạy background tokio::spawn, không block request.
# JANITOR_INTERVAL_SECS=21600

# Grace period khi SIGTERM trước khi force exit. Phải KHỚP với
# `stop_grace_period` trong compose (default 30s cả hai). Nếu mismatch:
# - app force-exit trước docker SIGKILL → request đang xử lý bị đứt.
# - docker SIGKILL trước app force-exit → process killed không clean.
# GRACEFUL_SHUTDOWN_TIMEOUT_SECS=30

# ─── Bảo mật proxy (tuỳ chọn — mặc định bật) ────────────────
# Có tin header X-Forwarded-For / X-Real-IP / CF-Connecting-IP khi xác
# định IP client cho rate-limit + audit không?
# - BẬT (mặc định): prod chạy sau Traefik/Coolify/CDN, IP thật nằm trong
#   header. IP TCP local là IP của proxy, không có ý nghĩa.
# - TẮT (false/0/no/off): khi expose trực tiếp internet — header do client
#   tự gắn sẽ bị giả để lách rate-limit; IP sẽ lấy từ kết nối TCP thật.
# TRUST_PROXY_HEADERS=true

# ─── Logging ────────────────────────────────────────────────
# RUST_LOG: tracing-subscriber env filter. Format:
#   khogame=info,tower_http=warn  → khogame crate INFO+, tower_http WARN+
#   khogame=debug                  → verbose (dev only, log rất nhiều)
#   info                           → tất cả crate INFO+ (nhiều noise)
RUST_LOG=khogame=info,tower_http=warn

# ─── Tuỳ chọn khác ──────────────────────────────────────────
# GitHub token (optional, tăng rate limit khi fetch metadata repo từ
# GitHub API cho /repos endpoint). Không có → API rate limit 60/giờ
# cho IP client; có token → 5000/giờ. PAT classic với scope `public_repo`
# là đủ (chỉ read public repos).
# GITHUB_TOKEN=ghp_xxx

# Thư mục lưu trữ file user upload (Docker volume). Prod: Coolify
# mount persistent volume. Local: docker-compose.yml mount `storage:/app/storage`.
# STORAGE_DIR=/app/storage

# ─── News module (v0.8.0) ────────────────────────────────────
# Tin tức user đăng luôn vào hàng đợi 'pending', admin duyệt mới published.
# Không có env riêng — workflow cố định để chống tin giả.

# ─── User tracking (v0.8.0) ─────────────────────────────────
# Migration 009 thêm 5 cột: signup_ip, signup_ua, last_login_ip,
# last_login_ua, last_login_at. Tự động capture trong auth handler.
# Chỉ admin xem được; moderator không thấy.
