# ===== Server =====
HOST=0.0.0.0
PORT=3000
BASE_URL=https://louis.vangioitutien.com

# ===== Database PostgreSQL 17 =====
DATABASE_URL=postgres://khogame:password@localhost:5432/khogame

# ===== Session =====
# Generate: openssl rand -hex 32
SESSION_KEY=replace-with-your-64-byte-hex-random-string

# ===== Google OAuth 2.0 =====
# Lấy tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-secret
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# ===== Admin =====
# Email này tự động được cấp quyền Admin khi đăng nhập Google
ADMIN_EMAIL=khongdich.admin@gmail.com

# ===== AI Agent (tùy chọn — để trống nếu không dùng) =====
# Secret chia sẻ out-of-band cho AI Agent được phép. BẮT BUỘC ở prod
# nếu muốn bật tính năng AI; để trống = endpoint /auth/ai/* trả 503.
# Generate: openssl rand -hex 32
# AI_AGENT_SECRET=
# Số ngày sống của phiên AI Agent (mặc định 90)
# AI_AGENT_SESSION_TTL_DAYS=90

# ===== Tuỳ chọn =====
# GitHub token (tăng rate limit khi fetch metadata repo)
# GITHUB_TOKEN=ghp_xxx
# Thư mục lưu trữ file (Docker volume)
# STORAGE_DIR=/app/storage
RUST_LOG=khogame=info,tower_http=warn

# ===== Database pool tuning (tuỳ chọn) =====
# DB_MAX_CONNECTIONS=15
# DB_MIN_CONNECTIONS=1
# DB_ACQUIRE_TIMEOUT_SECS=10

# ===== Vận hành (tuỳ chọn) =====
# Chu kỳ janitor dọn session/notification/daily_stats (giây, tối thiểu 60)
# JANITOR_INTERVAL_SECS=21600
# Thời gian chờ request hoàn tất khi SIGTERM trước khi force exit (giây)
# Nên khớp stop_grace_period trong compose (mặc định 30)
# GRACEFUL_SHUTDOWN_TIMEOUT_SECS=30
