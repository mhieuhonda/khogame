# ===== Server =====
HOST=0.0.0.0
PORT=3000
BASE_URL=https://louis.vangioitutien.com

# ===== Database PostgreSQL 17 =====
DATABASE_URL=postgres://khogame:password@localhost:5432/khogame

# ===== Session =====
# Generate: openssl rand -hex 32
SESSION_KEY=replace-with-your-64-byte-hex-random-string

# ===== Google OAuth 2.0 =====
# Lấy tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-secret
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# ===== Admin =====
# Email này tự động được cấp quyền Admin khi đăng nhập Google
ADMIN_EMAIL=khongdich.admin@gmail.com

# ===== Tuỳ chọn =====
# GitHub token (tăng rate limit khi fetch metadata repo)
# GITHUB_TOKEN=ghp_xxx
# Thư mục lưu trữ file (Docker volume)
# STORAGE_DIR=/app/storage
RUST_LOG=khogame=info,tower_http=warn

# ===== Database pool tuning (tuỳ chọn) =====
# DB_MAX_CONNECTIONS=15
# DB_MIN_CONNECTIONS=1
# DB_ACQUIRE_TIMEOUT_SECS=10
